# AWS Transcribe Credentials
# Required when running bin/run-pipeline with the live awstranscriber GStreamer element
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-west-2

# ZeroMQ Addresses (Optional - defaults to 127.0.0.1)
# SCALECC_PUBLISH_ADDRESS=tcp://127.0.0.1:4040
# SCALECC_REQUEST_ADDRESS=tcp://127.0.0.1:4050
